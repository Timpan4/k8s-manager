{
  "name": "kubecove",
  "private": true,
  "version": "0.10.10",
  "packageManager": "bun@1.4.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/frontend-dev.ts",
    "tauri:dev-server": "bun scripts/tauri-dev-server.ts",
    "build": "bun run typecheck && bun scripts/frontend-build.ts",
    "preview": "bun scripts/frontend-preview.ts",
    "tauri": "bun scripts/tauri.ts",
    "test": "bun test",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "svelte:check": "node scripts/svelte-check-with-typescript6.cjs --no-tsconfig --ignore \"src/features/resources/topology-spike\"",
    "lint": "biome lint .",
    "lint:anti-slop": "bun scripts/lint-anti-slop.ts",
    "audit": "bun scripts/audit-dependencies.ts",
    "perf:startup": "bun e2e/lifecycle.ts desktop-profile",
    "perf:frontend": "bun scripts/perf-frontend.ts",
    "perf:resource-scope": "bun scripts/perf-resource-scope.ts",
    "rust:bench": "cargo bench --manifest-path src-tauri/Cargo.toml --features bench-support --bench backend_hot_paths",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "docs:check": "bun scripts/check-docs.ts",
    "check": "bun run typecheck && bun run svelte:check && bun run lint && bun run lint:anti-slop && bun run docs:check && bun test && bun run rust:test && bun run rust:check && bun run rust:lint",
    "version:bump": "bun scripts/bump-version.ts",
    "release:prepare": "bun scripts/prepare-release-pr.ts",
    "release:check": "bun scripts/release-beta.ts check",
    "release:dry-run": "bun scripts/release-beta.ts dry-run",
    "release": "bun scripts/release-beta.ts release",
    "e2e:fast": "bun e2e/lifecycle.ts fast",
    "e2e:real": "bun e2e/lifecycle.ts run",
    "e2e:cleanup": "bun e2e/lifecycle.ts cleanup",
    "e2e:desktop-smoke": "bun e2e/lifecycle.ts desktop-smoke",
    "dev:kind": "bun e2e/lifecycle.ts dev-up",
    "dev:kind:down": "bun e2e/lifecycle.ts dev-down"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@tanstack/svelte-query": "6.1.38",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@codspeed/vitest-plugin": "5.7.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@oxlint/plugins": "1.81.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.0",
    "@typescript/typescript6": "6.0.2",
    "@wdio/cli": "9.31.5",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.3.0",
    "@xyflow/svelte": "1.6.6",
    "@xyflow/system": "0.0.82",
    "bits-ui": "2.19.0",
    "bun-plugin-tailwind": "0.1.2",
    "fast-check": "4.9.0",
    "lucide-svelte": "1.0.1",
    "oxlint": "1.81.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "webdriverio": "9.31.5"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@wdio/native-utils": "2.5.0",
    "deepmerge-ts": "8.0.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "serialize-javascript": "7.0.7"
  }
}
